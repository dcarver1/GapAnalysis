Version: 1.0
ProjectId: 77cd7ab8-41c5-4d9a-ab12-0259329bc346

RestoreWorkspace: No
SaveWorkspace: No
AlwaysSaveHistory: Default

EnableCodeIndexing: Yes
UseSpacesForTab: Yes
NumSpacesForTab: 2
Encoding: UTF-8

RnwWeave: Sweave
LaTeX: pdfLaTeX

AutoAppendNewline: Yes
StripTrailingWhitespace: Yes

BuildType: Package
PackageUseDevtools: Yes
PackageInstallArgs: --as-cran
PackageBuildArgs: --as-cran
PackageBuildBinaryArgs: --as-cran
PackageCheckArgs: --as-cran
PackageRoxygenize: rd,collate,namespace
